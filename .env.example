# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://mybusiness:mybusiness_dev@localhost:5432/mybusiness
TEST_DATABASE_URL=postgresql+psycopg://mybusiness:mybusiness_dev@localhost:5432/mybusiness_test

# --- Safety posture ---
# DRY_RUN=true means no real external-world action ever executes.
# Turning this off is one of the two deliberate acts required to send for real
# (the other is enabling autonomy for the action type in config/policies.yaml).
DRY_RUN=true
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Providers ---
# "mock" is the only implemented option for everything except LLM. Milestone 8 adds real
# providers one at a time; LLM_PROVIDER=anthropic is the first (requires
# ANTHROPIC_API_KEY below). Turning this on does not by itself change the safety
# posture above — DRY_RUN and per-action autonomy in config/policies.yaml still gate
# every world-changing action; a real LLM only means drafts are real text instead of a
# mock marker.
LLM_PROVIDER=mock
WEB_RESEARCH_PROVIDER=mock
LEAD_DISCOVERY_PROVIDER=mock
EMAIL_PROVIDER=mock
CRM_PROVIDER=mock
CALENDAR_PROVIDER=mock
PAYMENT_PROVIDER=mock
# Used by the UGC Viral Cloner (ugc_cloner/) for rendering shots and voice-over.
# "heygen"/"elevenlabs" are real, in addition to "mock" — see avatar/UPLOAD_INSTRUCTIONS.md
# for the one-time avatar/voice training that produces the IDs below.
VIDEO_GEN_PROVIDER=mock
VOICE_PROVIDER=mock

# Deterministic seed for mock providers so runs and tests are reproducible.
MOCK_SEED=1337

# --- Secrets (only read by provider adapters, never by agents or prompts) ---
ANTHROPIC_API_KEY=
# Only consulted when LLM_PROVIDER=anthropic. See providers/anthropic_llm.py for which
# models this is known to behave correctly with (effort support, pricing table).
ANTHROPIC_MODEL=claude-opus-5

# Only consulted when VIDEO_GEN_PROVIDER=heygen. HEYGEN_AVATAR_ID comes from training the
# CEO's avatar in the HeyGen dashboard first — see avatar/UPLOAD_INSTRUCTIONS.md.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Only consulted when VOICE_PROVIDER=elevenlabs. ELEVENLABS_VOICE_ID comes from cloning the
# CEO's voice in the ElevenLabs dashboard first — see avatar/UPLOAD_INSTRUCTIONS.md.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
