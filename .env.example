# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://mybusiness:mybusiness_dev@localhost:5432/mybusiness
TEST_DATABASE_URL=postgresql+psycopg://mybusiness:mybusiness_dev@localhost:5432/mybusiness_test

# --- Safety posture ---
# DRY_RUN=true means no real external-world action ever executes.
# Turning this off is one of the two deliberate acts required to send for real
# (the other is enabling autonomy for the action type in config/policies.yaml).
DRY_RUN=true
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Providers ---
# "mock" is the only implemented option today. Real providers land in Milestone 8.
LLM_PROVIDER=mock
WEB_RESEARCH_PROVIDER=mock
LEAD_DISCOVERY_PROVIDER=mock
EMAIL_PROVIDER=mock
CRM_PROVIDER=mock
CALENDAR_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Deterministic seed for mock providers so runs and tests are reproducible.
MOCK_SEED=1337

# --- Secrets (only read by provider adapters, never by agents or prompts) ---
ANTHROPIC_API_KEY=
